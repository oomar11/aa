# قاعدة بيانات الورشة المشتركة (Postgres / Neon / Vercel Postgres)
# انسخ Connection string من Neon → حطه هنا باسم DATABASE_URL
DATABASE_URL=

# بدائل يقرأها البرنامج أيضاً إن وُجدت
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=
# NEON_DATABASE_URL=

# ربط خزنة المتجر — تلقائي من السيرفر (مُفضّل)
# STORE_URL=https://store-system-rho.vercel.app
# WORKSHOP_BRIDGE_SECRET=  ← نفس مفتاح جسر الورش على المتجر
# المتصفح مش بيشوف المفتاح؛ الطلبات تعدّي من /api/store-bridge/*
