# قاعدة بيانات الورشة المشتركة (Supabase)
# البرنامج يستخدم Supabase REST افتراضياً لمشروع workshop-windoor.
# اختياري: DATABASE_URL (Postgres pooled) أو:
# SUPABASE_URL=https://jhlyjcdfxprendfdnuoe.supabase.co
# SUPABASE_ANON_KEY=...

# بدائل يقرأها البرنامج أيضاً إن وُجدت
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=

# ربط خزنة المتجر — تلقائي من السيرفر (مُفضّل)
# STORE_URL=https://store-system-rho.vercel.app
# WORKSHOP_BRIDGE_SECRET=  ← نفس مفتاح جسر الورش على المتجر
# المتصفح مش بيشوف المفتاح؛ الطلبات تعدّي من /api/store-bridge/*
